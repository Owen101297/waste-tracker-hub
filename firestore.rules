rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user has the 'admin' role
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Institutions collection
    match /institutions/{institutionId} {
      // Admin can read all; clients can read only their own
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Admin can create new institutions
      allow create: if isAdmin();

      // Owner or admin can update
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Only admin can delete
      allow delete: if isAdmin();

      // Waste records subcollection
      match /wasteRecords/{recordId} {
        allow read, write: if isAuthenticated() &&
          (get(/databases/$(database)/documents/institutions/$(institutionId)).data.userId == request.auth.uid
           || isAdmin());
      }
    }
  }
}